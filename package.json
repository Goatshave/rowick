{
  "name": "rowick-workspace",
  "private": true,
  "version": "0.1.0",
  "description": "MIT open-source, multi-framework data grid foundation.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --fail-if-no-match --filter \"./packages/*\" build",
    "api:check": "node scripts/api-contract.mjs",
    "api:update": "node scripts/api-contract.mjs --write",
    "check": "pnpm -r --fail-if-no-match --filter \"./packages/*\" --filter @rowick/example-shared-server check",
    "test": "pnpm test:release && pnpm -r --fail-if-no-match --filter \"./packages/*\" --filter @rowick/example-shared-server test",
    "test:xlsx:independent": "pnpm --filter @rowick/export-xlsx test:independent",
    "test:release": "node --test scripts/test/*.test.mjs",
    "lint": "pnpm -r --fail-if-no-match --filter \"./packages/*\" lint",
    "release:check": "node scripts/release-check.mjs",
    "release:consumer-smoke": "node scripts/release-consumer-smoke.mjs",
    "release:first-publish-next-step": "node scripts/release-first-publish-status.mjs --next-step",
    "release:first-publish-preflight": "node scripts/release-first-publish-preflight.mjs",
    "release:first-publish-status": "node scripts/release-first-publish-status.mjs",
    "release:github-push-preflight": "node scripts/release-github-push-preflight.mjs",
    "release:plan": "node scripts/release-plan.mjs",
    "release:policy": "node scripts/release-policy.mjs",
    "release:publish": "node scripts/release-publish.mjs",
    "release:publish-dry-run": "node scripts/release-publish-dry-run.mjs",
    "release:stage": "node scripts/release-stage.mjs",
    "release:trusted-publishing": "node scripts/release-trusted-publishing.mjs",
    "release:ui-smoke-report-check": "node scripts/ui-smoke-report-check.mjs",
    "review:smoke-ui": "node scripts/ui-smoke-review.mjs",
    "dev:react": "pnpm --filter @rowick/example-react-basic dev",
    "dev:server": "pnpm --filter @rowick/example-react-server-side dev",
    "dev:server-grouping": "pnpm --filter @rowick/example-react-server-grouping dev",
    "dev:server-tree": "pnpm --filter @rowick/example-react-server-tree dev",
    "dev:vue": "pnpm --filter @rowick/example-vue-grouped dev",
    "dev:vue-server": "pnpm --filter @rowick/example-vue-server-side dev",
    "dev:vue-server-tree": "pnpm --filter @rowick/example-vue-server-tree dev",
    "dev:svelte": "pnpm --filter @rowick/example-svelte-grouped dev",
    "dev:svelte-server": "pnpm --filter @rowick/example-svelte-server-side dev",
    "dev:svelte-server-tree": "pnpm --filter @rowick/example-svelte-server-tree dev",
    "dev:nextjs": "pnpm --filter @rowick/example-nextjs-server-export dev",
    "dev:nuxt": "pnpm --filter @rowick/example-nuxt-server-export dev",
    "dev:sveltekit": "pnpm --filter @rowick/example-sveltekit-server-export dev",
    "preview:smoke-ui": "node scripts/ui-smoke-preview.mjs",
    "build:examples": "pnpm -r --fail-if-no-match --filter \"./examples/*\" build",
    "compatibility:versions": "node scripts/compatibility-versions.mjs",
    "compatibility:check": "pnpm compatibility:versions && pnpm -r --fail-if-no-match --filter \"./compatibility/*\" build",
    "e2e": "pnpm build && playwright test",
    "e2e:renderers": "pnpm build && playwright test --config playwright.renderers.config.ts",
    "e2e:server-lifecycle": "pnpm build && playwright test --config playwright.server-lifecycle.config.ts",
    "e2e:smoke": "pnpm build && playwright test --config playwright.smoke.config.ts",
    "security:audit": "node scripts/dependency-audit.mjs",
    "e2e:server-data": "pnpm build && playwright test --config playwright.server-data.config.ts",
    "e2e:integration": "pnpm build && playwright test --config playwright.integration.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "terser": "5.51.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11",
    "yaml": "2.9.1"
  },
  "pnpm": {
    "overrides": {
      "source-map-js@<1.2.2": "1.2.2",
      "devalue@>=5.0.0 <5.9.3": "5.9.3",
      "esbuild@>=0.27.0 <0.28.1": "0.28.1",
      "serialize-javascript@>=7.0.0 <7.1.3": "7.1.3",
      "seroval@>=1.6.0 <1.6.11": "1.6.11",
      "node-forge@<1.4.1": "1.4.1",
      "@vercel/nft@1.11.0>glob": "14.0.2",
      "archiver-utils@5.0.2>glob": "14.0.2",
      "readdir-glob@1.1.3>minimatch": "11.0.1"
    },
    "patchedDependencies": {
      "deepmerge@4.3.1": "patches/deepmerge@4.3.1.patch"
    }
  }
}
