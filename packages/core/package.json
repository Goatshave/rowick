{
  "name": "@rowick/core",
  "version": "0.1.0",
  "description": "Framework-agnostic data grid engine.",
  "keywords": ["data-grid", "grid", "table", "headless", "typescript"],
  "homepage": "https://github.com/Goatshave/rowick/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/Goatshave/rowick/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "LICENSE"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --minify --sourcemap",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
