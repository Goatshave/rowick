{
  "name": "@rowick/react-ui",
  "version": "0.1.0",
  "description": "Optional styled React data grid for Rowick.",
  "keywords": [
    "data-grid",
    "grid",
    "table",
    "react",
    "ui"
  ],
  "homepage": "https://github.com/Goatshave/rowick/tree/main/packages/react-ui#readme",
  "bugs": {
    "url": "https://github.com/Goatshave/rowick/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "dist/index.css",
    "dist/virtual.css",
    "dist/editing.css",
    "src/index.css",
    "src/virtual.css",
    "src/editing.css",
    "dist/filtering.css",
    "dist/analytics.css",
    "dist/layout.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./virtual": {
      "types": "./dist/virtual.d.ts",
      "import": "./dist/virtual.js"
    },
    "./editing": {
      "types": "./dist/editing.d.ts",
      "import": "./dist/editing.js"
    },
    "./editing.css": "./dist/editing.css",
    "./css": "./dist/index.css",
    "./virtual.css": "./dist/virtual.css",
    "./filtering": {
      "types": "./dist/filtering.d.ts",
      "import": "./dist/filtering.js"
    },
    "./filtering.css": "./dist/filtering.css",
    "./server-data": {
      "types": "./dist/server-data.d.ts",
      "import": "./dist/server-data.js"
    },
    "./analytics": {
      "types": "./dist/analytics.d.ts",
      "import": "./dist/analytics.js"
    },
    "./analytics.css": "./dist/analytics.css",
    "./layout": {
      "types": "./dist/layout.d.ts",
      "import": "./dist/layout.js"
    },
    "./layout.css": "./dist/layout.css"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.tsx src/virtual.tsx src/editing.tsx src/filtering.tsx src/server-data.tsx src/analytics.tsx src/layout.tsx --format esm --dts --clean --external react --external react/jsx-runtime --external react-dom && node ../../scripts/copy-build-assets.mjs react-ui",
    "check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@rowick/data": "workspace:*",
    "@rowick/core": "workspace:*",
    "@rowick/primitives": "workspace:*",
    "@rowick/react": "workspace:*",
    "@rowick/virtual": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
