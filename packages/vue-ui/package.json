{
  "name": "@rowick/vue-ui",
  "version": "0.1.0",
  "description": "Optional styled Vue data grid for Rowick.",
  "keywords": [
    "data-grid",
    "grid",
    "table",
    "vue",
    "ui"
  ],
  "homepage": "https://github.com/Goatshave/rowick/tree/main/packages/vue-ui#readme",
  "bugs": {
    "url": "https://github.com/Goatshave/rowick/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "dist/index.css",
    "dist/editing.css",
    "dist/filtering.css",
    "dist/analytics.css",
    "dist/layout.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./css": "./dist/index.css",
    "./editing": {
      "types": "./dist/editing.d.ts",
      "import": "./dist/editing.js"
    },
    "./editing.css": "./dist/editing.css",
    "./filtering": {
      "types": "./dist/filtering.d.ts",
      "import": "./dist/filtering.js"
    },
    "./filtering.css": "./dist/filtering.css",
    "./server-data": {
      "types": "./dist/server-data.d.ts",
      "import": "./dist/server-data.js"
    },
    "./analytics": {
      "types": "./dist/analytics.d.ts",
      "import": "./dist/analytics.js"
    },
    "./analytics.css": "./dist/analytics.css",
    "./layout": {
      "types": "./dist/layout.d.ts",
      "import": "./dist/layout.js"
    },
    "./layout.css": "./dist/layout.css"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/editing.ts src/filtering.ts src/server-data.ts src/analytics.ts src/layout.ts --format esm --dts --clean --external vue && node ../../scripts/copy-build-assets.mjs vue-ui",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@rowick/data": "workspace:*",
    "@rowick/core": "workspace:*",
    "@rowick/primitives": "workspace:*",
    "@rowick/vue": "workspace:*",
    "@rowick/virtual": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vue/server-renderer": "^3.5.44",
    "tsup": "^8.3.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "vue": "^3.5.44"
  }
}
